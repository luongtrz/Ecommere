# Database
DATABASE_URL="postgresql://user:pass@localhost:5432/thaispray_shop?schema=public"

# JWT
JWT_ACCESS_SECRET="replace-with-access-secret"
JWT_REFRESH_SECRET="replace-with-refresh-secret"
TOKEN_EXPIRES_IN="15m"
REFRESH_EXPIRES_IN="7d"

# Server
PORT=4001
NODE_ENV="development"

# CORS
CORS_ORIGIN="http://localhost:5174"

# Uploads
UPLOAD_DIR="./uploads"
CLOUDINARY_CLOUD_NAME="replace-with-cloudinary-cloud-name"
CLOUDINARY_API_KEY="replace-with-cloudinary-api-key"
CLOUDINARY_API_SECRET="replace-with-cloudinary-api-secret"
CLOUDINARY_FOLDER="thaispray"

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# AI agent (OpenAI)
OPENAI_API_KEY="replace-with-openai-api-key"
OPENAI_BASE_URL=""
AGENT_MODEL="gpt-4.1-mini"
AGENT_TEMPERATURE=0.2
AGENT_MAX_OUTPUT_TOKENS=800
AGENT_TIMEOUT_MS=90000
AGENT_MAX_STEPS=24
AGENT_MAX_TOOL_CALLS_PER_TURN=6
AGENT_HISTORY_MAX_MESSAGES=30
AGENT_CHECKPOINT_SCHEMA="agent"
